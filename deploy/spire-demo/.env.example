# Read by scripts/lib.sh. Copy to .env to override (.env is gitignored).
TRUST_DOMAIN=attesta.example.org
AGENT_ID=spiffe://attesta.example.org/agent/demo
JOIN_TOKEN_TTL=300
CI_RUNNER_ID=spiffe://attesta.example.org/ci/build-runner
CI_RUNNER_UID=1001
SCORING_ID=spiffe://attesta.example.org/scoring-service
SCORING_UID=1002
GATEWAY_ID=spiffe://attesta.example.org/gateway
GATEWAY_UID=1003
FABRIC_BRIDGE_ID=spiffe://attesta.example.org/fabric-bridge
FABRIC_BRIDGE_UID=1004
AUDITOR_BRIDGE_ID=spiffe://attesta.example.org/fabric-bridge-auditor
AUDITOR_BRIDGE_UID=1005
AUDITOR_ID=spiffe://attesta.example.org/auditor
AUDITOR_UID=1006
DASHBOARD_ID=spiffe://attesta.example.org/dashboard
DASHBOARD_UID=1007
# Set to the dashboard checkout to run it with scripts/dashboard-up.sh:
# ATTESTA_DASHBOARD_DIR="/mnt/c/path/to/dashboard"
# Set to the attesta_DL checkout to score with the trained detector (quote paths with spaces):
# ATTESTA_DL_DIR="/mnt/c/path/to/attesta_DL"
# Advisory LLM review: model name, and the key in .runtime/llm_api_key (see docker-compose.llm.yml):
# ATTESTA_LLM_MODEL=gemini-flash-latest
